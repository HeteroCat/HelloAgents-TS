{
  "name": "hello-agents-ts",
  "version": "1.0.0",
  "description": "Production-grade multi-agent framework - TypeScript version",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "npm run build && node tests/smoke.cjs",
    "test:package": "npm run build && node tests/package-consume.cjs",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "prepack": "npm run build && npm test && npm run typecheck:examples",
    "pack:dry-run": "npm pack --dry-run --cache ./.npm-cache",
    "example:quickstart": "ts-node examples/01-quickstart.ts",
    "example:tools": "ts-node examples/02-custom-tools.ts",
    "example:react": "ts-node examples/03-react-agent.ts",
    "example:agents": "ts-node examples/04-all-agents.ts",
    "example:context": "ts-node examples/05-context-engineering.ts"
  },
  "license": "CC-BY-NC-SA-4.0",
  "dependencies": {
    "openai": "^4.0.0",
    "dotenv": "^16.0.0",
    "zod": "^3.22.0",
    "tiktoken": "^1.0.0",
    "yaml": "^2.3.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0"
  }
}
